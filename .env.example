# LegacyChain configuration
#
# Every value here is OPTIONAL. With an empty file the app runs fully in
# local mode: a JSON file store, locally derived anchors, and heuristic
# enrichment. Fill a section in to promote that subsystem to live.
#
# Copy to .env.local before editing.

# --- Database (Neon) -------------------------------------------------------
# Unset -> a JSON file store under .data/. Set -> tables are created automatically.
DATABASE_URL=

# --- AI enrichment (Anthropic) ---------------------------------------------
# Unset -> metadata-only heuristics, labelled as such in the UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Blockchain anchoring (Ethereum Sepolia via Dwellir) -------------------
# All three must be set for anchors to be written on-chain. Otherwise the
# record id is derived locally and shown as "simulated", never as mined.
#   1. npm run contract:compile
#   2. npm run contract:deploy
#   3. paste the printed address below
ETH_RPC_URL=
ETH_PRIVATE_KEY=
HERITAGE_REGISTRY_ADDRESS=
ETH_CHAIN_ID=11155111
ETH_NETWORK_NAME=Ethereum Sepolia
ETH_EXPLORER_BASE=https://sepolia.etherscan.io

# --- Post-quantum signing key ---------------------------------------------
# 32 bytes of hex (64 characters) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECURITY: derives the ML-DSA-44 private key. Never commit a real value.
# Unset -> a fixed, public development seed.
PQC_GUARDIAN_SEED=

# --- Identity (Neuro) ------------------------------------------------------
# Provision once with:
#   NEURO_API_KEY=<key> NEURO_API_SECRET=<secret> npm run neuro:provision
# (key and secret come from https://blockathon.neuro-tech.io/sandbox.html#api-access)
# It prints the four values below. Unset -> the guardian shows as Unverified.
# SECURITY: NEURO_ACCOUNT_PASSWORD authorizes signed requests. Never commit it.
NEURO_HOST=
NEURO_USERNAME=
NEURO_ACCOUNT_PASSWORD=
NEURO_LEGAL_ID=

# --- Misc ------------------------------------------------------------------
LOCAL_DATA_DIR=.data
NEXT_PUBLIC_BASE_URL=http://localhost:3000
